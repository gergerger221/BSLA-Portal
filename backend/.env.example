# SIA Enrollment System - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_HOST=127.0.0.1
DB_NAME=sia_highschool_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SMTP / Email Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_AUTH=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=School Admissions
SMTP_REPLY_TO=your-email@gmail.com
SMTP_DEBUG=0

# PayMongo Payment Gateway Configuration
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_PUBLIC_KEY=pk_test_...

# HTTP Email API Configuration (Optional fallback for cloud hosting)
RESEND_API_KEY=
BREVO_API_KEY=

# Security Configuration
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,http://bsla.infy.click,https://bsla.infy.click
TOKEN_EXPIRY_HOURS=24

