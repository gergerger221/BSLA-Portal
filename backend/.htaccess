# SIA Backend Security Configuration - Deny direct web access to sensitive assets

# Block direct access to environment files, composer manifests, logs, and database dumps
<FilesMatch "(^\.env|composer\.(json|lock)|\.(sql|bak|dump|log|ini|yml|yaml))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory browsing
Options -Indexes

# Restrict direct access to core PHP source folders (Routing must go through api/index.php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|controllers|helpers|middleware|services|vendor)/ - [F,L]
</IfModule>
